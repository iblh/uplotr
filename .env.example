# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lorawan_tracker?schema=public"

# AUTH_SECRET is used to sign session cookies (JWT)
AUTH_SECRET="change_this_to_a_long_random_string_min_32_chars"

# OFF | OPTIONAL | REQUIRED. Keep REQUIRED on internet-facing instances.
AUTH_MODE="REQUIRED"

# Secures the scheduled retention cleanup endpoint.
CRON_SECRET="change_this_to_another_long_random_string"

# Optional map configuration. OPENFREEMAP requires no token.
MAP_PROVIDER="OPENFREEMAP"
# MAPBOX_TOKEN="pk..."

# Optional Google Analytics (GA4). Leave unset to disable.
# Self-hosted instances ship with no product analytics; only the official
# uplotr.com deployment sets this.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
